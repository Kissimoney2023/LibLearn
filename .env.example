# ---- AI Tutor (server-side only) ----
# Read by server.ts. NEVER exposed to the browser - the client calls
# /api/ai/tutor and the server holds this key.
# AI Studio injects it at runtime from user secrets; set it yourself elsewhere.
GEMINI_API_KEY=""

# APP_URL: where this app is hosted. Used for OAuth callbacks and self-links.
APP_URL=""

# ---- Supabase (optional) ----
# Without these, LibLearn runs in LOCAL MODE: accounts and progress are stored
# in the browser only, and the UI says so. Set both to enable real accounts
# that sync across devices.
# Only the publishable anon key belongs here - it is safe in the browser under
# row-level security. The service-role key must never appear in client code.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Base URL for the API. Leave empty for same-origin (the default).
VITE_API_BASE_URL=""
