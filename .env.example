# =====================================================================
# LibLearn environment variables
#
# THE VITE_ PREFIX IS THE SECURITY BOUNDARY.
#   VITE_*  -> inlined into the client bundle at build time. PUBLIC.
#   no VITE_ -> server-side only. Never reaches the browser.
#
# Putting a secret behind a VITE_ prefix publishes it to every visitor.
# =====================================================================

# ---- Supabase (client, public) ----
# The anon key is safe here: row-level security governs every table.
# See supabase/migrations/0001_init.sql
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# NEVER add the Supabase service_role key. Not to this file, not to Vercel,
# not anywhere. It bypasses row-level security entirely. The app does not
# need it.

# ---- AI Tutor (server-side only) ----
# Read by api/ai/tutor.ts on Vercel, and by server.ts locally.
# Leave empty and the tutor returns an explicit 503 instead of a fake reply.
GEMINI_API_KEY=""

# ---- Optional ----
# Base URL for the API. Leave empty for same-origin, which is correct on Vercel.
VITE_API_BASE_URL=""

# Set to "true" only for static-host preview builds without SPA rewrites
# (routes through the hash). Vercel does NOT need this - vercel.json has the
# rewrite rule.
VITE_HASH_ROUTER=""
